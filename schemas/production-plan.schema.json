{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creator OS Production Plan",
  "type": "object",
  "required": [
    "content_id",
    "brand_id",
    "format",
    "scenes"
  ],
  "properties": {
    "content_id": {
      "type": "string"
    },
    "brand_id": {
      "enum": [
        "TES",
        "ATW",
        "CA"
      ]
    },
    "format": {
      "type": "string"
    },
    "aspect_ratio": {
      "type": "string"
    },
    "frame_rate": {
      "type": "number"
    },
    "target_duration_seconds": {
      "type": "number",
      "minimum": 1
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "order",
          "visual_direction"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "narration": {
            "type": "string"
          },
          "on_screen_text": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visual_direction": {
            "type": "string"
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "motion_notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
