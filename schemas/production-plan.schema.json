{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creator OS Production Plan",
  "type": "object",
  "required": [
    "content_id",
    "brand_id",
    "format",
    "scenes"
  ],
  "properties": {
    "content_id": {
      "type": "string"
    },
    "brand_id": {
      "enum": [
        "TES",
        "ATW",
        "CA"
      ]
    },
    "format": {
      "type": "string"
    },
    "aspect_ratio": {
      "type": "string"
    },
    "frame_rate": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "target_duration_seconds": {
      "type": "number",
      "minimum": 1
    },
    "render_profile": {
      "type": "string"
    },
    "voiceover_asset_id": {
      "type": "string"
    },
    "human_approval_required": {
      "type": "boolean"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "order",
          "visual_direction"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "render_mode": {
            "enum": [
              "remotion",
              "html-gsap",
              "screen-recording",
              "generated-footage",
              "editorial-footage",
              "mixed"
            ]
          },
          "narration": {
            "type": "string"
          },
          "on_screen_text": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "caption_text": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visual_direction": {
            "type": "string"
          },
          "composition_notes": {
            "type": "string"
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "motion_notes": {
            "type": "string"
          },
          "transition_in": {
            "type": "string"
          },
          "transition_out": {
            "type": "string"
          },
          "continuity_notes": {
            "type": "string"
          },
          "safe_area_notes": {
            "type": "string"
          },
          "fallback_render_mode": {
            "enum": [
              "remotion",
              "html-gsap",
              "screen-recording",
              "generated-footage",
              "editorial-footage",
              "mixed"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
